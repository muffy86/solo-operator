# ============================================================
#  solo-operator — projects root
# ============================================================

# ---- Nested project repositories (each has its own .git) ----
# Excluding these prevents git from creating gitlinks/submodule
# entries for repos that are versioned independently.
/my-node-app/
/csv-pipeline/

# ---- Secrets / credentials (NEVER commit) ----
.env
.env.*
!.env.example
*.env
*.env.*
*.pgpass
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.secret
*.credentials
*.local
id_rsa
id_dsa
id_ecdsa
id_ed25519
secrets/
credentials
credentials.*

# ---- OS / editor cruft ----
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
*.tmp
*.orig
*.rej

# ---- Logs / runtime output ----
*.log
logs/
tmp/
temp/

# ---- Language / build caches (root-level) ----
__pycache__/
*.py[cod]
node_modules/
dist/
build/
.cache/

# ---- Local override of the compose file (keep secrets out) ----
docker-compose.override.yml
docker-compose.*.local.yml
